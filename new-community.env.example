# Append these to the SERVER .env. Keep all existing legacy settings unchanged.
NEW_GUILD_ID=
NEW_TRADE_FORUM_IDS=
NEW_TRADE_BUY_TAG_MAP=
NEW_TRADE_SELL_TAG_MAP=
NEW_TRADE_CATEGORY_ID=
NEW_TRADE_LOG_CHANNEL_ID=
NEW_TRADE_STATS_CHANNEL_ID=
NEW_ALERT_CHANNEL_ID=
NEW_INVITE_RANKING_CHANNEL_ID=
NEW_INVITE_CHANNEL_ID=
NEW_INVITE_VERIFIED_ROLE_ID=
NEW_TRADE_ADMIN_ROLE_IDS=
NEW_NOTICE_ADMIN_ROLE_IDS=
NEW_VERIFY_CHANNEL_ID=
NEW_RULES_CHANNEL_ID=
NEW_LANGUAGE_CHANNEL_ID=
# Forum where the bot publishes the beginner payment guide.
NEW_GUIDES_CHANNE_ID=
# Optional: required when the guides forum requires a tag.
NEW_GUIDES_TAG_ID=
# Join this voice channel to create a temporary room in the category below.
# Leave either empty to disable dynamic voice rooms.
NEW_VOICE_CREATE_CHANNEL_ID=
NEW_VOICE_CATEGORY_ID=
# Required for posting links; multiple qualifying roles separated by commas.
# Missing/invalid IDs block links from all human members in the new guild.
NEW_LV3_ROLE_IDS=
NEW_LANGUAGE_CHINESE_ROLE_ID=
NEW_LANGUAGE_TAGALOG_ROLE_ID=
NEW_LANGUAGE_INDONESIAN_ROLE_ID=
NEW_LANGUAGE_JAPANESE_ROLE_ID=
NEW_LANGUAGE_KOREAN_ROLE_ID=
NEW_LANGUAGE_MALAY_ROLE_ID=
NEW_LANGUAGE_PORTUGUESE_ROLE_ID=
NEW_LANGUAGE_SPANISH_ROLE_ID=
NEW_LANGUAGE_THAI_ROLE_ID=
NEW_LANGUAGE_VIETNAMESE_ROLE_ID=

# Distinct from each other and MYSQL_DATABASE. Same MySQL host and credentials.
NEW_MYSQL_DATABASE=trade_bot_new
PAYMENTS_MYSQL_DATABASE=trade_bot_payments
NEW_MAX_ACTIVE_TRADES=5

# Enable ONLY after prepare_shared_payments.py succeeds while the bot is stopped.
SHARED_PAYMENTS_ENABLED=false

# NEW_WITHDRAW_AMOUNT_MODE is retired and ignored. BSC payouts use fee-inclusive
# request amounts from the spot wallet, verified by the completed external test.
